<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warna putih dengan transparansi 90% (Kesan Kaca) -->
    <solid android:color="#E6FFFFFF" />

    <!-- Sudut yang sangat melengkung (Liquid feel) -->
    <corners android:radius="40dp" />

    <!-- Garis tepi (stroke) tipis transparan untuk pantulan cahaya kaca -->
    <stroke
        android:width="1.5dp"
        android:color="#80FFFFFF" />
</shape>